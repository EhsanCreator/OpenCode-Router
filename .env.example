# OpenCode Router - Environment Configuration Template
# Copy this file to .env to customize local server defaults.

# Web Dashboard Port
PORT=3000

# Proxy Engine Inbound Ports
OPENCODE_HTTP_PROXY_PORT=10809
OPENCODE_SOCKS_PROXY_PORT=10808

# OpenCode Binary Path (Optional override; auto-detected if left empty)
# OPENCODE_BIN=/usr/local/bin/opencode

# Maximum testing attempts per automated workflow run
MAX_TEST_ATTEMPTS=25

# Timeout in seconds for OpenCode validation prompt
OPENCODE_TIMEOUT_SECONDS=18
